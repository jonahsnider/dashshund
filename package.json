{
	"name": "dashshund",
	"version": "2026.7.1",
	"private": true,
	"description": "FRC dashboard for viewing camera streams",
	"author": "Team 581",
	"type": "module",
	"scripts": {
		"build": "pnpm tauri build",
		"build:frontend": "pnpm typecheck && vite build",
		"dev": "pnpm tauri dev",
		"dev:frontend": "vite dev",
		"generate-icons": "tauri icon assets/logo.svg",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@fontsource/geist-mono": "5.3.0",
		"@solid-primitives/storage": "4.4.0",
		"@solid-primitives/timer": "1.4.4",
		"@tailwindcss/vite": "4.3.3",
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-os": "2.4.0",
		"@tauri-apps/plugin-updater": "2.14.1",
		"ntcore-ts-client": "3.1.3",
		"solid-icons": "1.2.0",
		"solid-js": "1.9.17",
		"tailwindcss": "4.3.3",
		"url-parse-lax": "6.0.0"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.3",
		"@types/node": "24.19.2",
		"@types/url-parse-lax": "5.0.2",
		"fallow": "3.34.1",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vite-plugin-solid": "2.11.14"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.14.0"
}
